# =============================================================================
# Joblin environment variables
# Copy this file to .env and fill in your values.
# =============================================================================

# === Auth (Required) ===

# Your Authentik username -- MUST match exactly (case-sensitive) what you log
# in with at https://your-authentik-host/if/user/
# This is used by the database migration to pre-seed the admin user row.
# If this does not match your actual Authentik login name, you will see an
# empty onboarding screen on first login.
#
# To find your Authentik username: log into Authentik, click your avatar top-
# right, select "User settings". Your username is shown at the top.
#
# If you already deployed with the wrong value and see empty data, fix it with:
#   docker exec joblin-app-1 python -c "
#     import sqlite3; c=sqlite3.connect('/app/data/joblin.db')
#     c.execute('DELETE FROM users WHERE id=2')
#     c.execute(\"UPDATE users SET authentik_username='YOUR_USERNAME' WHERE id=1\")
#     c.commit(); print('done')
#   "
# Note: always DELETE the wrong row BEFORE UPDATE to avoid the unique constraint.
ADMIN_USERNAME=yourname

# === LLM providers (at least one required) ===

# Groq -- used for the filter pass (fast, cheap).
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Cerebras -- used for the summarize pass (high quality).
# Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Gemini Flash Lite -- fallback if both above are unavailable.
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# === Optional ===

# SQLite database path. Default inside Docker: /app/data/joblin.db
# Uncomment and change only if you need a custom path.
# DATABASE_URL=sqlite+aiosqlite:///./joblin.db

# Discord webhook URL for job match notifications.
# You can also set this from the Settings page in the UI after first login.
DISCORD_WEBHOOK_URL=
